# 统一行尾，避免 Windows 上 core.autocrlf 造成整文件 diff 噪音
* text=auto eol=lf

# 明确指定文本类型
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.ps1  text eol=crlf

# 二进制文件不做转换
*.webp binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
